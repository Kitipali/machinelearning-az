





import numpy as np #para manejo de datos
import matplotlib.pyplot as plt # para graficos
import pandas as pd #para cargar el DF





dataset = pd.read_csv('Ads_CTR_Optimisation.csv')


dataset.head() #filas: usuarios/rondas #columnas: anuncios. 1->Hace click 0 -No hace click





import math
N = 10000 #Simulamos 10000 usuarios
d = 10 # Tenemos 1o anuncios distintos (0, 1,...,9)
ads_selected = [] # lista con el anuncio seleccionado en cada ronda-> Al final tendrá 10.000 números: en cada posición, el anuncio que se mostró en esa ronda.
numbers_of_selections = [0] * d # cuántas veces se ha mostrado cada anuncio. Crea una lista de longitud d (en este caso, d = 10, porque hay 10 anuncios).Inicializa todos sus valores a 0.
sums_of_rewards = [0] * d # suma total de recompensas por anuncio (cuantos clics ha recibido cada anuncio). Crea una lista de longitud d (en este caso, d = 10, porque hay 10 anuncios).Inicializa todos sus valores a 0.
total_reward = 0 #→ número total de clics de todos los anuncios, al final de todo.
for n in range(0, N): #Bucle principal -> Usuario por usuario -> “Para este usuario n, quiero decidir qué anuncio mostrar.Voy a mirar todos los anuncios (0…9) y me quedo con el que tenga mejor pinta.”
    ad = 0 #por defecto, ya lo cambiaremos
    max_upper_bound = 0  #→ vamos a ir buscando el anuncio con el mayor “score”.Por defecto = 0 Cambiará
    for i in range(0, d): # Bucle interior: decido qué anuncio es mejor para esta ronda.Aquí miramos cada anuncio i y calculamos su “puntuación” upper_bound
        if (numbers_of_selections[i] > 0):
            average_reward = sums_of_rewards[i] / numbers_of_selections[i]#recompensa media
            delta_i = math.sqrt(3/2 * math.log(n + 1) / numbers_of_selections[i]) #amplitud del intervalo (incertidumbre). Si el anuncio se ha mostrado pocas veces, este delta será más grande.Si se ha mostrado muchas veces, el delta será pequeño.
            upper_bound = average_reward + delta_i # putnuación final del anuncio
        else: #Si numbers_of_selections[i] == 0, no tenemos ni media ni nada.
            upper_bound = 1e400 # 1 x 10^400 (un número gigante)-> Obliga a que cada anuncio se explore al menos una vez
        if upper_bound > max_upper_bound:
            max_upper_bound = upper_bound
            ad = i
    ads_selected.append(ad)
    numbers_of_selections[ad] = numbers_of_selections[ad] + 1 #Sumamos 1 al número de veces que se ha mostrado ese anuncio:
    reward = dataset.values[n, ad] #Miramos el dataset para ver si ese usuario hizo clic o no: 1hubo click 0 No hubo click
    sums_of_rewards[ad] = sums_of_rewards[ad] + reward
    total_reward = total_reward + reward





plt.hist(ads_selected)
plt.title('Histogram of ads selections')
plt.xlabel('Ads')
plt.ylabel('Number of times each ad was selected')
plt.show()



