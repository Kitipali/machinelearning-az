import numpy as np
import matplotlib.pyplot as plt
import pandas as pd






dataset = pd.read_csv('Restaurant_Reviews.tsv', delimiter = '\t', quoting = 3)
# \ -> barra escapante -> Indica un caracter especial: t -> tab (tabulador)
# quoting = 3 -> Lo mismo que quoting = '' -> Esto ignora las comillas simples (o dobles) en la importación del dataset





import re
import nltk


nltk.download('stopwords') # descarga las palabras irrelevantes


from nltk.corpus import stopwords 
#Incorporo esa lista de palabras descargadas


from nltk.stem.porter import PorterStemmer # para "stemizar"-> eliminar las declinaciones/conjugaciones de una determinada palabra


review = re.sub('[^a-zA-Z]', ' ', dataset['Review'][0])


review = review.lower() #Lo paso a minúsculas


review= review.split() # separamos la cadena de caracteres en un array de caracteres. Un array de palabras sueltas


ps = PorterStemmer()


review = [ps.stem(word) for word in review if not word in set(stopwords.words('english'))]
# revisa palabra a palabra  del array review y las incluye en una lista excepto a aquéllas que no sean stopword en el diccionario  inglés (quitando la declinación)
# Añadimos set() para generar un conjunto. Es más agil que una lista basada en índices


review = ' '.join(review) #une lo esté en review separado por espacios (' ')


review





import re

# re -> regular expressions (expresiones regulares)

import nltk
nltk.download('stopwords') # descarga las palabras irrelevantes
from nltk.corpus import stopwords
from nltk.stem.porter import PorterStemmer
corpus = []
for i in range(0, 1000):
  review = re.sub('[^a-zA-Z]', ' ', dataset['Review'][i])
    # '[]' -> conjunto que quiero eliminar
    # '[^]' -> conjunto que NO quiero eliminar. ^ -> Lo contrario a...
    # '[^a-zA-Z]' -> Quiero quedarme con las letras de la A a la Z en minúsculas y mayúsculas
    # Lo sustituimos por ' ' (un espacio en blanco)
  review = review.lower() #lo paso a minúsculas
  review = review.split() # separamos la cadena de caracteres en un array de caracteres. Un array de palabras sueltas
  ps = PorterStemmer()
  all_stopwords = stopwords.words('english')
  all_stopwords.remove('not')
  review = [ps.stem(word) for word in review if not word in set(all_stopwords)]
  review = ' '.join(review)
  corpus.append(review)


print(corpus)





from sklearn.feature_extraction.text import CountVectorizer #conviertes las palabras en vectores (word to vec)

cv = CountVectorizer(max_features = 1500) # max_features = 1500 -> coge sólo las 1500 palabras (columnas) más comunes
X = cv.fit_transform(corpus).toarray() # .toarray() Para trasnformar en una matriz que luego aceptará nuestro modelo de clasificación
y = dataset.iloc[:, -1].values





from sklearn.model_selection import train_test_split
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size = 0.20, random_state = 0)





from sklearn.naive_bayes import GaussianNB
classifier = GaussianNB()
classifier.fit(X_train, y_train)





y_pred = classifier.predict(X_test)
print(np.concatenate((y_pred.reshape(len(y_pred),1), y_test.reshape(len(y_test),1)),1))





from sklearn.metrics import confusion_matrix, accuracy_score
cm = confusion_matrix(y_test, y_pred)
print(cm)
accuracy_score(y_test, y_pred)


# 42 falsos positivos y 12 falsos negativos


from sklearn.metrics import precision_score
from sklearn.metrics import recall_score
from sklearn.metrics import f1_score

precision = precision_score(y_test, y_pred)
print("Precisión:", precision)

recall = recall_score(y_test, y_pred)
print("Recall:", recall)
f1 = f1_score(y_test, y_pred)
print("F1:", f1)











from sklearn.linear_model import LogisticRegression
